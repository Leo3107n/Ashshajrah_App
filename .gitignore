.local-backups/
design-reference/
brightspace-intelligence.git-backup/

# Local environment and secret material
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
**/.secrets/
**/secrets.local/
**/credentials.local/
**/credentials*.json
**/service-account*.json

# Private keys and signing credentials
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.mobileprovision

# Database exports and local databases
**/*.dump
**/*.backup
**/*.bak
**/*.sqlite
**/*.sqlite3
**/*.db
**/database-backups/

# User-generated/private storage
**/uploads/
**/private-uploads/
**/storage/private/

# Local tool state, caches, and logs
.codex/
.agents/
**/node_modules/
**/.expo/
**/.next/
**/.vercel/
**/coverage/
**/*.log
**/logs/
**/.cache/
**/tmp/
**/temp/
