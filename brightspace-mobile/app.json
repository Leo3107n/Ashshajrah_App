{
  "expo": {
    "name": "Ash-Shajrah LMS",
    "slug": "brightspace-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "brightspace",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.healingcodes.brightspace"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FAF7F0"
      },
      "package": "com.healingcodes.brightspace"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#063F32"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/"
    }
  }
}
