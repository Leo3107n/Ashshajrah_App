generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique @db.VarChar(50)
  description String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  users       User[]
  user_roles  user_roles[]

  @@map("roles")
}

model User {
  id                                                                       String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id                                                                  String                        @db.Uuid
  full_name                                                                String                        @db.VarChar(150)
  email                                                                    String?                       @unique(map: "users_email_unique") @db.VarChar(150)
  phone                                                                    String?                       @unique(map: "users_phone_unique") @db.VarChar(50)
  password_hash                                                            String?
  status                                                                   user_status                   @default(pending)
  must_change_password                                                     Boolean?                      @default(true)
  last_login_at                                                            DateTime?                     @db.Timestamp(6)
  created_at                                                               DateTime?                     @default(now()) @db.Timestamp(6)
  updated_at                                                               DateTime?                     @default(now()) @db.Timestamp(6)
  username                                                                 String?
  audit_logs                                                               audit_logs[]
  coordinator_profiles                                                     coordinator_profiles?
  credential_dispatch_logs_credential_dispatch_logs_parent_user_idTousers  credential_dispatch_logs[]    @relation("credential_dispatch_logs_parent_user_idTousers")
  credential_dispatch_logs_credential_dispatch_logs_student_user_idTousers credential_dispatch_logs[]    @relation("credential_dispatch_logs_student_user_idTousers")
  fee_submissions                                                          fee_submissions[]
  fee_verifications                                                        fee_verifications[]
  fee_vouchers                                                             fee_vouchers[]
  headlines                                                                headlines[]
  interested_students                                                      interested_students[]
  internal_events_internal_events_attendee_user_idTousers                  internal_events[]             @relation("internal_events_attendee_user_idTousers")
  internal_events_internal_events_created_byTousers                        internal_events[]             @relation("internal_events_created_byTousers")
  internal_events_internal_events_host_user_idTousers                      internal_events[]             @relation("internal_events_host_user_idTousers")
  lecture_attendance                                                       lecture_attendance[]
  lecture_schedules                                                        lecture_schedules[]
  lecture_verifications                                                    lecture_verifications[]
  note_thread_messages                                                     note_thread_messages[]
  notifications                                                            notifications[]
  outbound_messages                                                        outbound_messages[]
  parent_profiles                                                          parent_profiles?
  public_event_registrations                                               public_event_registrations[]
  public_events                                                            public_events[]
  regular_monthly_fee_batches                                              regular_monthly_fee_batches[]
  student_profiles                                                         student_profiles?
  teacher_assignments                                                      teacher_assignments[]
  teacher_profiles                                                         teacher_profiles?
  role                                                                     Role                          @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_roles                                                               user_roles[]

  @@index([role_id], map: "idx_users_role_id")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

model user_roles {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  role_id    String    @db.Uuid
  is_primary Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  roles      Role      @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, role_id], map: "user_roles_user_id_role_id_key")
  @@index([user_id], map: "idx_user_roles_user_id")
  @@index([role_id], map: "idx_user_roles_role_id")
}

model audit_logs {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_user_id String?   @db.Uuid
  action        String    @db.VarChar(150)
  entity_type   String    @db.VarChar(100)
  entity_id     String?   @db.Uuid
  old_data      Json?
  new_data      Json?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  users         User?     @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)

  @@index([actor_user_id], map: "idx_audit_logs_actor")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model career_applications {
  id                String   @id
  full_name         String
  email             String
  whatsapp          String
  interested_role   String
  message           String?
  resume_file_name  String
  resume_mime_type  String?
  resume_size_bytes Int?
  source            String
  status            String   @default("new")
  admin_notes       String?
  submitted_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)
  resume_file_data  Bytes?

  @@index([status])
  @@index([submitted_at(sort: Desc)])
}

model coordinator_profiles {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String       @unique @db.Uuid
  department String?      @db.VarChar(150)
  status     user_status? @default(active)
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  updated_at DateTime?    @default(now()) @db.Timestamp(6)
  users      User         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model course_subjects {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id  String    @db.Uuid
  subject_id String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamp(6)
  courses    courses   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects   subjects  @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([course_id, subject_id], map: "course_subject_unique")
  @@index([course_id], map: "idx_course_subjects_course_id")
  @@index([subject_id], map: "idx_course_subjects_subject_id")
}

model courses {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                       String                        @db.VarChar(150)
  class_level                 String?                       @unique(map: "courses_class_level_unique") @db.VarChar(100)
  description                 String?
  status                      user_status?                  @default(active)
  created_at                  DateTime?                     @default(now()) @db.Timestamp(6)
  updated_at                  DateTime?                     @default(now()) @db.Timestamp(6)
  course_subjects             course_subjects[]
  enrollments                 enrollments[]
  note_threads                note_threads[]
  regular_fee                 regular_fee?
  regular_monthly_fee_batches regular_monthly_fee_batches[]
  teacher_assignments         teacher_assignments[]
}

model credential_dispatch_logs {
  id                                                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registration_id                                       String?             @db.Uuid
  parent_user_id                                        String?             @db.Uuid
  student_user_id                                       String?             @db.Uuid
  sent_to_email                                         String?             @db.VarChar(150)
  sent_to_phone                                         String?             @db.VarChar(50)
  channel                                               String?             @db.VarChar(100)
  status                                                String?             @default("pending") @db.VarChar(100)
  error_message                                         String?
  sent_at                                               DateTime?           @db.Timestamp(6)
  created_at                                            DateTime?           @default(now()) @db.Timestamp(6)
  users_credential_dispatch_logs_parent_user_idTousers  User?               @relation("credential_dispatch_logs_parent_user_idTousers", fields: [parent_user_id], references: [id], onUpdate: NoAction)
  registration_leads                                    registration_leads? @relation(fields: [registration_id], references: [id], onUpdate: NoAction)
  users_credential_dispatch_logs_student_user_idTousers User?               @relation("credential_dispatch_logs_student_user_idTousers", fields: [student_user_id], references: [id], onUpdate: NoAction)
}

model discounts {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label        String         @unique
  percent      Decimal        @db.Decimal(5, 2)
  status       String         @default("active")
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  fee_vouchers fee_vouchers[]
}

model enrollments {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id         String              @db.Uuid
  course_id          String              @db.Uuid
  registration_id    String?             @db.Uuid
  start_date         DateTime            @default(dbgenerated("CURRENT_DATE")) @db.Date
  end_date           DateTime?           @db.Date
  status             String              @default("active") @db.VarChar(50)
  created_at         DateTime?           @default(now()) @db.Timestamp(6)
  updated_at         DateTime?           @default(now()) @db.Timestamp(6)
  courses            courses             @relation(fields: [course_id], references: [id], onUpdate: NoAction)
  registration_leads registration_leads? @relation(fields: [registration_id], references: [id], onUpdate: NoAction)
  student_profiles   student_profiles    @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lecture_schedules  lecture_schedules[]

  @@unique([student_id, course_id], map: "enrollment_student_course_unique")
  @@index([course_id], map: "idx_enrollments_course_id")
  @@index([student_id], map: "idx_enrollments_student_id")
}

model fee_settings {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  key         String   @unique
  value       String   @default("")
  description String?
  status      String   @default("active")
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)
  label       String?
}

model fee_submissions {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucher_id        String                @db.Uuid
  submitted_by      String?               @db.Uuid
  payer_name        String?               @db.VarChar(150)
  transaction_id    String?               @db.VarChar(150)
  paid_amount       Decimal               @db.Decimal(12, 2)
  paid_at           DateTime?             @db.Timestamp(6)
  proof_bucket      String?               @default("payment_proofs") @db.VarChar(100)
  proof_file_path   String
  proof_file_url    String?
  remarks           String?
  created_at        DateTime?             @default(now()) @db.Timestamp(6)
  updated_at        DateTime?             @default(now()) @db.Timestamp(6)
  status            fee_submission_status @default(pending)
  users             User?                 @relation(fields: [submitted_by], references: [id], onUpdate: NoAction)
  fee_vouchers      fee_vouchers          @relation(fields: [voucher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fee_verifications fee_verifications[]

  @@index([voucher_id], map: "idx_fee_submissions_voucher_id")
}

model fee_verifications {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fee_submission_id String          @db.Uuid
  verified_by       String          @db.Uuid
  reason            String?
  verified_at       DateTime?       @default(now()) @db.Timestamp(6)
  fee_submissions   fee_submissions @relation(fields: [fee_submission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             User            @relation(fields: [verified_by], references: [id], onUpdate: NoAction)
}

model fee_vouchers {
  id                                                                                          String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucher_no                                                                                  String                              @unique @db.VarChar(100)
  registration_id                                                                             String?                             @db.Uuid
  student_id                                                                                  String?                             @db.Uuid
  amount                                                                                      Decimal                             @db.Decimal(12, 2)
  due_date                                                                                    DateTime                            @db.Date
  payment_method                                                                              payment_method?                     @default(bank)
  payment_instructions                                                                        String?
  status                                                                                      voucher_status                      @default(unpaid)
  created_by                                                                                  String?                             @db.Uuid
  created_at                                                                                  DateTime?                           @default(now()) @db.Timestamp(6)
  updated_at                                                                                  DateTime?                           @default(now()) @db.Timestamp(6)
  registration_lead_id                                                                        String?                             @db.Uuid
  regular_fee_applied                                                                         Boolean                             @default(false)
  regular_fee_amount                                                                          Decimal                             @default(0) @db.Decimal(12, 2)
  admission_fee_amount                                                                        Decimal                             @default(0) @db.Decimal(12, 2)
  discount_id                                                                                 String?                             @db.Uuid
  discount_percent                                                                            Decimal                             @default(0) @db.Decimal(5, 2)
  subtotal_amount                                                                             Decimal                             @default(0) @db.Decimal(12, 2)
  discount_amount                                                                             Decimal                             @default(0) @db.Decimal(12, 2)
  total_amount                                                                                Decimal                             @default(0) @db.Decimal(12, 2)
  payment_method_id                                                                           String?                             @db.Uuid
  regular_fee_id                                                                              String?                             @db.Uuid
  payment_method_options                                                                      Json                                @default("[]")
  scholarship_form_id                                                                         String?                             @db.Uuid
  scholarship_amount                                                                          Decimal                             @default(0) @db.Decimal(12, 2)
  fee_submissions                                                                             fee_submissions[]
  users                                                                                       User?                               @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  discounts                                                                                   discounts?                          @relation(fields: [discount_id], references: [id], onUpdate: NoAction)
  payment_methods                                                                             payment_methods?                    @relation(fields: [payment_method_id], references: [id], onUpdate: NoAction)
  registration_leads                                                                          registration_leads?                 @relation(fields: [registration_id], references: [id], onUpdate: NoAction)
  regular_fee                                                                                 regular_fee?                        @relation(fields: [regular_fee_id], references: [id], onUpdate: NoAction)
  need_based_scholarship_forms_fee_vouchers_scholarship_form_idToneed_based_scholarship_forms need_based_scholarship_forms?       @relation("fee_vouchers_scholarship_form_idToneed_based_scholarship_forms", fields: [scholarship_form_id], references: [id], onUpdate: NoAction, map: "fee_vouchers_scholarship_form_fkey")
  student_profiles                                                                            student_profiles?                   @relation(fields: [student_id], references: [id], onUpdate: NoAction)
  need_based_scholarship_forms                                                                need_based_scholarship_forms[]
  regular_monthly_fee_voucher_items                                                           regular_monthly_fee_voucher_items[]
  voucher_line_items                                                                          voucher_line_items[]

  @@index([registration_id], map: "idx_fee_vouchers_registration_id")
  @@index([status], map: "idx_fee_vouchers_status")
  @@index([student_id], map: "idx_fee_vouchers_student_id")
  @@index([scholarship_form_id], map: "idx_fee_vouchers_scholarship_form_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model headlines {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  headline   String
  start_date DateTime @db.Date
  end_date   DateTime @db.Date
  created_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  users      User?    @relation(fields: [created_by], references: [id], onUpdate: NoAction)

  @@index([start_date, end_date], map: "idx_headlines_active_dates")
}

model homework {
  id                           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lecture_id                   String?            @db.Uuid
  student_id                   String             @db.Uuid
  teacher_id                   String             @db.Uuid
  title                        String             @db.VarChar(200)
  description                  String?
  due_date                     DateTime?          @db.Date
  status                       homework_status?   @default(pending)
  created_at                   DateTime?          @default(now()) @db.Timestamp(6)
  updated_at                   DateTime?          @default(now()) @db.Timestamp(6)
  submission_note              String?
  submission_attachment_bucket String?            @db.VarChar(100)
  submission_attachment_path   String?
  submission_attachment_name   String?
  submitted_at                 DateTime?          @db.Timestamp(6)
  subject_id                   String?            @db.Uuid
  lecture_schedules            lecture_schedules? @relation(fields: [lecture_id], references: [id], onUpdate: NoAction)
  student_profiles             student_profiles   @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects                     subjects?          @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher_profiles             teacher_profiles   @relation(fields: [teacher_id], references: [id], onUpdate: NoAction)

  @@index([student_id], map: "idx_homework_student_id")
  @@index([subject_id], map: "idx_homework_subject_id")
}

model interested_student_reminder_logs {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interested_student_id String              @db.Uuid
  reminder_no           Int                 @default(1)
  channel               String
  status                String              @default("sent")
  sent_at               DateTime            @default(now()) @db.Timestamp(6)
  error_message         String?
  meta                  Json?
  created_at            DateTime            @default(now()) @db.Timestamp(6)
  updated_at            DateTime            @default(now()) @db.Timestamp(6)
  interested_students   interested_students @relation(fields: [interested_student_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "interested_student_reminder_logs_student_fkey")

  @@index([sent_at(sort: Desc)], map: "idx_interested_student_reminder_logs_sent_at")
  @@index([interested_student_id], map: "idx_interested_student_reminder_logs_student_id")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model interested_students {
  id                               String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_name                     String
  parent_name                      String
  email                            String
  phone                            String
  source                           String                             @default("website")
  status                           String                             @default("new")
  registration_token               String?                            @unique
  registration_link_generated_at   DateTime?                          @db.Timestamp(6)
  registration_link_generated_by   String?                            @db.Uuid
  registration_lead_id             String?                            @db.Uuid
  notes                            String?
  created_at                       DateTime                           @default(now()) @db.Timestamp(6)
  updated_at                       DateTime                           @default(now()) @db.Timestamp(6)
  child_name                       String?
  class_level                      String?
  message                          String?
  website                          String?
  registration_source              String?                            @default("website")
  parent_relation                  String?
  gender                           String?
  child_dob                        DateTime?                          @db.Date
  current_school                   String?
  why_interested                   String?
  heard_about                      String?
  questions_comments               String?
  admission_form_sent_at           DateTime?                          @db.Timestamp(6)
  admission_form_due_at            DateTime?                          @db.Timestamp(6)
  admission_form_last_reminder_at  DateTime?                          @db.Timestamp(6)
  admission_form_reminder_count    Int                                @default(0)
  admission_form_status            String                             @default("pending")
  admission_form_submitted_at      DateTime?                          @db.Timestamp(6)
  admission_form_last_channel      String?
  admission_form_last_error        String?
  registration_code                String?                            @unique(map: "idx_interested_students_registration_code") @default(dbgenerated("('ALHA-'::text || lpad((nextval('interested_students_registration_code_seq'::regclass))::text, 4, '0'::text))"))
  country                          String?
  city                             String?
  parent_interview_link_sent_at    DateTime?                          @db.Timestamptz(6)
  parent_interview_url             String?
  parent_interview_status          String?
  parent_form_sent_status          String                             @default("no")
  parent_interview_submitted_at    DateTime?                          @db.Timestamptz(6)
  interested_student_reminder_logs interested_student_reminder_logs[]
  registration_leads               registration_leads?                @relation(fields: [registration_lead_id], references: [id], onUpdate: NoAction)
  users                            User?                              @relation(fields: [registration_link_generated_by], references: [id], onUpdate: NoAction)
  need_based_scholarship_forms     need_based_scholarship_forms[]

  @@index([created_at(sort: Desc)], map: "idx_interested_students_created_at")
  @@index([phone], map: "idx_interested_students_phone")
  @@index([registration_token], map: "idx_interested_students_registration_token")
  @@index([status], map: "idx_interested_students_status")
  @@index([admission_form_due_at], map: "idx_interested_students_admission_form_due_at")
  @@index([admission_form_sent_at], map: "idx_interested_students_admission_form_sent_at")
  @@index([admission_form_status], map: "idx_interested_students_admission_form_status")
  @@index([child_name], map: "idx_interested_students_child_name")
  @@index([city], map: "idx_interested_students_city")
  @@index([country], map: "idx_interested_students_country")
  @@index([parent_form_sent_status], map: "idx_interested_students_parent_form_sent_status")
}

model internal_events {
  id                                            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                                         String
  description                                   String?
  host_user_id                                  String?   @db.Uuid
  attendee_user_id                              String    @db.Uuid
  scheduled_start                               DateTime  @db.Timestamptz(6)
  scheduled_end                                 DateTime  @db.Timestamptz(6)
  status                                        String    @default("scheduled")
  google_calendar_event_id                      String?
  google_meet_link                              String?
  google_meet_space_id                          String?
  calendar_html_link                            String?
  recording_drive_url                           String?
  recording_synced_at                           DateTime? @db.Timestamptz(6)
  google_last_error                             String?
  created_by                                    String?   @db.Uuid
  created_at                                    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                                    DateTime  @default(now()) @db.Timestamptz(6)
  users_internal_events_attendee_user_idTousers User      @relation("internal_events_attendee_user_idTousers", fields: [attendee_user_id], references: [id], onUpdate: NoAction)
  users_internal_events_created_byTousers       User?     @relation("internal_events_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  users_internal_events_host_user_idTousers     User?     @relation("internal_events_host_user_idTousers", fields: [host_user_id], references: [id], onUpdate: NoAction)

  @@index([attendee_user_id], map: "idx_internal_events_attendee")
  @@index([google_calendar_event_id], map: "idx_internal_events_google_calendar_event")
  @@index([host_user_id], map: "idx_internal_events_host")
  @@index([scheduled_start(sort: Desc)], map: "idx_internal_events_scheduled_start")
}

model lecture_attendance {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lecture_id            String             @db.Uuid
  user_id               String             @db.Uuid
  role_type             String             @db.VarChar(50)
  joined_at             DateTime?          @db.Timestamp(6)
  left_at               DateTime?          @db.Timestamp(6)
  duration_minutes      Int?               @default(0)
  source                attendance_source? @default(manual)
  status                attendance_status? @default(absent)
  created_at            DateTime?          @default(now()) @db.Timestamp(6)
  updated_at            DateTime?          @default(now()) @db.Timestamp(6)
  participant_email     String?
  participant_name      String?
  google_participant_id String?            @db.VarChar(255)
  google_session_id     String?            @db.VarChar(255)
  meet_raw              Json?
  subject_id            String?            @db.Uuid
  lecture_schedules     lecture_schedules  @relation(fields: [lecture_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
