{
  "name": "lms-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "apply:user-roles": "prisma db execute --schema prisma/schema.prisma --file prisma/sql/multi_role_user_roles.sql",
    "verify:user-roles": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-user-roles-foundation.mjs",
    "verify:student": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-student-integration.mjs",
    "verify:parent": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-parent-integration.mjs",
    "seed:academic": "prisma db execute --schema prisma/schema.prisma --file prisma/seed-academic.sql",
    "seed:development-users": "prisma db execute --schema prisma/schema.prisma --file prisma/seed-development-users.sql"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "bcrypt": "^6.0.0",
    "framer-motion": "^12.40.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "ngrok": "^5.0.0-beta.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4"
  }
}
